// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "paragraph-tts-container",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {},
	"workspaceMount": "source=${localWorkspaceFolder}/,target=/home/devcontainer/workspace,type=bind",
	"workspaceFolder": "/home/devcontainer/workspace",
	"postCreateCommand": "/bin/bash .devcontainer/res/post_create_command.bash",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.autopep8",
				"ms-azuretools.vscode-docker",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"eamodio.gitlens",
				"streetsidesoftware.code-spell-checker",
				"matangover.mypy",
				"ms-toolsai.tensorboard",
				"skellock.just",
				"ms-toolsai.jupyter"
			]
		}
	},
	"runArgs": [
		"--gpus",
		"all",
		"--shm-size",
		"512m",
		"-p",
		"5000:5000",
		"-p",
		"5001:5001"
	]
}
